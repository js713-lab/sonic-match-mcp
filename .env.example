# Copy to .env (never commit real keys).
# v0 works offline-ish with the seed catalog even if every key below is empty.

# Optional: Gemini video understanding (analyze_video_music)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: Jamendo catalog search (recommend_bgm / search_music)
JAMENDO_CLIENT_ID=

# Optional: Freesound (beds / loops, not songs)
FREESOUND_API_KEY=

# Optional: user-owned licensed library JSON (Epidemic / Artlist you already pay for)
# See examples/user_library.example.json — we will not scrape those sites.
SONICMATCH_LIBRARY_PATH=
EPIDEMIC_LIBRARY_PATH=
ARTLIST_LIBRARY_PATH=

# Cache for downloads, proxies, keyframes, mix previews
SONICMATCH_CACHE_DIR=

# HTTP bind (only used with --http)
SONICMATCH_HTTP_HOST=127.0.0.1
SONICMATCH_HTTP_PORT=8765

# Hard cap on downloaded / copied video size
SONICMATCH_MAX_DOWNLOAD_MB=200

# Platform URL ingest via yt-dlp is OFF by default (ToS + extractors break).
# Prefer a local file. Set to 1 only if you accept that risk.
SONICMATCH_ALLOW_YTDLP=0
